// %decls: grouped by input number, kind and name; included files are only counted.
%decls
int one = 1;
struct S { int f; };
int a = 1, b = 2;
extern "C" int c_fn(int v) { return v; }
enum class E { X, Y };
using L = long;
one + 1
for (int i = 0; i < 2; ++i) ++one;
%undo 2
%decls
struct P { int x; };
bool operator==(P a, P b) { return a.x == b.x; }
P operator+(P a, P b) { return P{a.x + b.x}; }
%decls
