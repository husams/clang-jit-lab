// Inspector regression: readable text, invalid pointers and a protected page.
#include <sys/mman.h>
#include <unistd.h>
#include <stdexcept>
long page_size = sysconf(_SC_PAGESIZE);
char *make_guarded_page() { auto *p = static_cast<char *>(mmap(nullptr, page_size * 2, PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANONYMOUS, -1, 0)); if (p == MAP_FAILED) throw std::runtime_error("mmap failed"); if (mprotect(p + page_size, page_size, PROT_NONE)) throw std::runtime_error("mprotect failed"); p[page_size - 1] = 'X'; p[page_size - 3] = 'O'; p[page_size - 2] = 0; return p; }
char *guarded = make_guarded_page();
struct PointerCases { const char *text; const char *invalid; const char *nulltext; const char *boundary; const char *terminated; };
PointerCases pointers{"readable", reinterpret_cast<const char *>(1), nullptr, guarded + page_size - 1, guarded + page_size - 3};
